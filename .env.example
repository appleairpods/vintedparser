# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF_replace_me
# Telegram user id администратора (можно несколько через запятую)
ADMIN_IDS=

# --- База данных ---
# Внутри docker compose хост = postgres:5432, снаружи = localhost:5433
# (5433, чтобы не конфликтовать с уже установленным на машине PostgreSQL)
DATABASE_URL=postgresql+psycopg://vinted:vinted@localhost:5433/vinted

# --- Vinted ---
# Какие национальные площадки опрашиваем: коды через запятую.
# Доступны: de, fr, pl, it, es, uk, nl, be, at, cz, sk, lt, pt, se, fi, dk,
# hu, ro, gr, ie, lu, com. Каждый регион — отдельный цикл опроса, нагрузка
# растёт линейно, поэтому список стоит держать коротким.
# Первый в списке используется по умолчанию при создании фильтра.
#
# Vinted считает лимит запросов по IP, а не по домену, поэтому регионы делят
# общий бюджет: POLL_PAGES x регионы / POLL_INTERVAL. Четыре региона по две
# страницы каждые 4 секунды уже ловят 429. Хочешь больше стран или страниц —
# поднимай POLL_INTERVAL или подключай прокси.
VINTED_REGIONS=de,fr,pl,com
# Пауза между циклами опроса, сек.
# На vinted.com лента растёт примерно на 15 объявлений в секунду, а страница
# отдаёт максимум 96 позиций, поэтому 4 сек дают ~1.5x запаса по ёмкости.
POLL_INTERVAL=4
# Сколько страниц ленты забирать за цикл (96 объявлений на страницу, больше API
# не отдаёт). Одна страница чаще выгоднее, чем несколько реже: у соседних
# страниц заметное перекрытие.
POLL_PAGES=1
# Прокси для запросов к Vinted, пусто = прямое соединение
# Формат: http://user:pass@host:port
VINTED_PROXY=

# --- Подписка ---
# Цены в звёздах Telegram. Лимиты тарифов заданы в app/domain/plans.py:
# бесплатный — 10 уведомлений в сутки и 1 фильтр, Pro — без лимита и 10 фильтров.
SUB_STARS_30=150
SUB_STARS_90=350

# --- Ограничения ---
# Сколько дней хранить объявления, потом чистим
LISTING_TTL_DAYS=7
# Не уведомлять об объявлениях старше указанного возраста, мин
MAX_LISTING_AGE_MINUTES=60
# Сколько часов помнить id обработанных объявлений (защита от повторов)
SEEN_TTL_HOURS=24

# --- Прочее ---
LOG_LEVEL=INFO
